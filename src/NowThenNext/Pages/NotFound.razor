@page "/not-found"
@layout MainLayout

<PageTitle>Page Not Found - NowThenNext</PageTitle>

<div class="flex flex-col items-center justify-center min-h-screen bg-calm-bg px-4">
    <div class="text-center max-w-md">
        <div class="not-found-icon">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
        </div>
        <h1 class="text-3xl font-bold text-calm-text mb-3">
            Page Not Found
        </h1>
        <p class="text-lg text-calm-text-light mb-8">
            Sorry, that page doesn't exist. Let's get you back home.
        </p>
        <a href="/" class="go-home-button">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            Go Home
        </a>
    </div>
</div>

<style>
    .not-found-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 6rem;
        height: 6rem;
        background-color: rgba(91, 154, 154, 0.1);
        border-radius: 50%;
        margin: 0 auto 1.5rem;
        color: #5B9A9A;
    }

    .go-home-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem 2rem;
        min-height: 3rem;
        font-size: 1.125rem;
        font-weight: 600;
        background-color: #5B9A9A;
        color: white;
        border-radius: 0.75rem;
        text-decoration: none;
        box-shadow: 0 2px 8px rgba(91, 154, 154, 0.3);
        transition: all 0.2s ease;
    }

    .go-home-button:hover {
        background-color: #4A8585;
        box-shadow: 0 4px 12px rgba(91, 154, 154, 0.4);
    }
</style>
