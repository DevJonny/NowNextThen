@page "/zones/{ZoneSlug}"

<PageTitle>@(Zone?.Name ?? "Zone") zone - NowNextThen</PageTitle>

@if (Zone != null)
{
    <div class="flex flex-col min-h-screen">
        <header class="w-full max-w-4xl mx-auto px-4 sm:px-6 mb-6">
            <div class="flex items-center gap-4">
                <a href="zones" class="zones-icon-button" aria-label="Go back">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                </a>
                <h1 class="text-2xl sm:text-3xl font-bold" style="color: @Zone.ColorDark;">
                    @Zone.Name: @Zone.Tagline
                </h1>
            </div>
        </header>

        <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 pb-8 flex-1">
            <p class="text-lg text-calm-text-light mb-4 text-center">How do you feel?</p>
            <div class="feeling-grid">
                @foreach (var feeling in Zone.Feelings)
                {
                    <button type="button" class="feeling-tile" data-feeling="@feeling.Id"
                            disabled="@IsChoosing"
                            style="background-color: @Zone.ColorLight; border-color: @Zone.ColorDark;"
                            @onclick="() => ChooseAsync(feeling)">
                        <span class="feeling-tile-face">
                            <FeelingFace Feeling="feeling" />
                        </span>
                        <span class="feeling-tile-name">@feeling.Name</span>
                    </button>
                }
            </div>
        </main>
    </div>
}

<style>
    .zones-icon-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        flex-shrink: 0;
        border-radius: 0.75rem;
        background-color: white;
        color: #5B9A9A;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        transition: background-color 0.2s ease;
    }

    .zones-icon-button:hover {
        background-color: #F0EDE8;
    }

    .feeling-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .feeling-tile {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 1.25rem 0.75rem;
        border: 3px solid;
        border-radius: 1rem;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .feeling-tile:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
    }

    .feeling-tile:active {
        transform: translateY(0);
    }

    .feeling-tile-face {
        display: block;
        width: min(9rem, 32vw);
        aspect-ratio: 1;
    }

    .feeling-tile-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #3D4852;
    }

    @@media (min-width: 768px) {
        .feeling-grid {
            gap: 1.5rem;
        }

        .feeling-tile-face {
            width: 11rem;
        }

        .feeling-tile-name {
            font-size: 1.875rem;
        }
    }
</style>
