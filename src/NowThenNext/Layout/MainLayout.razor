@inherits LayoutComponentBase
@inject NowThenNext.Services.Sync.SyncService Sync

<div class="min-h-screen bg-calm-bg flex flex-col">
    <main class="flex-1 w-full max-w-5xl mx-auto px-6 py-8 sm:px-8 sm:py-10">
        <article class="h-full">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Kick off silent re-auth + initial sync once JS (GIS + Drive) is available.
            await Sync.InitializeAsync();
        }
    }
}
